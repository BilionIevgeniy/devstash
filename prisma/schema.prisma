generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  password       String?
  sessionVersion Int       @default(0)

  // Deprecated: superseded by Subscription and read by nothing. Dropped by a
  // later migration once the deploy without them is live, so the old
  // deployment and a rollback keep working (see context/todo.md).
  isPro                Boolean @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  accounts     Account[]
  sessions     Session[]
  items        Item[]
  itemTypes    ItemType[]
  collections  Collection[]
  tags         Tag[]
  subscription Subscription?
  preference   UserPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Owned by editor. A user with no row gets the default preferences.
model UserPreference {
  id       String  @id @default(cuid())
  userId   String  @unique
  fontSize Int
  tabSize  Int
  wordWrap Boolean
  minimap  Boolean
  theme    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Owned by billing. A user with no row is on the Free plan.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  status               String
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Item {
  id          String    @id @default(cuid())
  // Collated "und-x-icu" by the migration item_title_icu_collation, which Prisma
  // cannot express: a migration that recreates this column must set it again.
  title       String
  contentType String
  content     String?
  // Deprecated: replaced by fileKey and read by nothing (see context/todo.md).
  fileUrl     String?
  // The R2 object key under users/<userId>/, never a URL. Unique, so one
  // upload cannot back two items.
  fileKey     String?   @unique
  fileName    String?
  fileSize    Int?
  url         String?
  description String?
  isFavorite  Boolean   @default(false)
  // When it was starred. A toggle leaves updatedAt alone: favoriting is not an edit.
  favoritedAt DateTime?
  isPinned    Boolean   @default(false)
  language    String?

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  typeId String
  type   ItemType @relation(fields: [typeId], references: [id], onDelete: NoAction)

  collections ItemCollection[]
  tags        ItemTag[]

  // Search (ADR 0018). The item's tag names joined by toSearchTags
  // (items/domain/search-text.ts); every write of ItemTag sets it in the same
  // write: the items services, prisma/seed.ts, a future import.
  searchTags   String                   @default("")
  // A stored generated column over title, searchTags, description, content and
  // url, created by the migration search_vectors. Prisma does not model
  // generated columns and reads the expression as a default, so dbgenerated
  // holds it exactly as Postgres prints it (pg_get_expr): without it every
  // migrate dev would try to drop it. A change of the expression is a new
  // migration that drops and adds the column, and this text copied again.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('simple'::regconfig, regexp_replace(title, '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, regexp_replace(\"searchTags\", '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'A'::\"char\")) || setweight(to_tsvector('simple'::regconfig, regexp_replace(COALESCE(description, ''::text), '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, regexp_replace(((COALESCE(content, ''::text) || ' '::text) || COALESCE(url, ''::text)), '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'C'::\"char\"))"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The lists read a user's items newest first, all of them or of one type.
  @@index([userId, createdAt])
  @@index([userId, typeId, createdAt])
  @@index([typeId])
  // Full-text search, and typos in a title (pg_trgm).
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ItemType {
  id       String  @id @default(cuid())
  name     String
  icon     String?
  color    String?
  isSystem Boolean @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  @@index([userId])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean   @default(false)
  // When it was starred. A toggle leaves updatedAt alone: favoriting is not an edit.
  favoritedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemCollection[]

  // Search (ADR 0018): a stored generated column over name and description,
  // kept in dbgenerated for the same reason as Item.searchVector.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, regexp_replace(name, '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, regexp_replace(COALESCE(description, ''::text), '[^[:alnum:]]+'::text, ' '::text, 'g'::text)), 'B'::\"char\"))"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([searchVector], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ItemCollection {
  itemId       String
  collectionId String
  addedAt      DateTime @default(now())

  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([itemId, collectionId])
  @@index([collectionId])
}

model Tag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemTag[]

  @@unique([userId, name])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}
