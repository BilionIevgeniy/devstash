# Pooled connection (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Direct connection (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Password for the demo users created by the seed script. In development keep it
# in .env.demo instead (gitignored, the only env file Claude Code may read), so
# the ui-reviewer agent can sign in; the seed reads both files
SEED_DEMO_PASSWORD="change-me"

# NextAuth secret (generate with `npx auth secret`)
AUTH_SECRET="change-me"

# GitHub OAuth App (callback URL: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Trusted host for NextAuth when running the production build locally (npm run start); Vercel sets this automatically
AUTH_URL="http://localhost:3000"

# Public origin of the app, used for the links in verification and password reset emails.
# Required whenever NODE_ENV is production: set it in Vercel for Production and Preview, and keep http://localhost:3000 locally
APP_URL="http://localhost:3000"

# Resend API key (verification emails)
RESEND_API_KEY="your-resend-api-key"

# Sender for outgoing emails; the domain must be verified in Resend (onboarding@resend.dev only delivers to the Resend account owner)
EMAIL_FROM="DevStash <noreply@your-verified-domain.com>"

# Upstash Redis for rate limiting (create a database at console.upstash.com, copy the REST URL and token).
# Required in every environment because rate limiting fails closed without it: use a separate database
# for local development, and set both variables in Vercel for Production and Preview
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Cloudflare R2 Storage (R2 > Manage API tokens: an Object Read & Write token scoped to the bucket).
# The bucket stays private: files are read through signed URLs, so no public r2.dev URL is needed
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="devstash-files"

# Stripe (setup in docs/stripe-integration-plan.md, section 7). Hosted Checkout needs no publishable key.
# Developers > API keys: the secret key, from a sandbox locally
STRIPE_SECRET_KEY=""
# Signing secret of the webhook (whsec_...), a different one in each place:
# - Local: printed by `stripe listen --events checkout.session.completed,customer.subscription.updated,customer.subscription.deleted --forward-to localhost:3000/api/webhooks/stripe`. Keep it running, restart `npm run dev` after a change
# - Vercel: Stripe Dashboard > Developers > Webhooks > the devstash-production destination > Signing secret. Redeploy after a change
STRIPE_WEBHOOK_SECRET=""
# Product catalog > DevStash Pro: the ids of the $8 monthly and the $72 yearly price
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# Open AI Key
OPENAI_API_KEY=""

# Sentry error monitoring (docs/adr/0016-error-monitoring-with-sentry.md). Every variable is optional:
# with no DSN the SDK is off, so development needs no account.
# Create the organization in the EU data region (Frankfurt; it cannot be changed later) and a Next.js project.
# The DSN is public by design (it ships to the browser): its host must end in .de.sentry.io, or the SDK stays off.
# Anyone can post events with it, so give that client key a rate limit and Allowed Domains in Sentry (Project Settings > Client Keys).
# Set it in Vercel for Production and Preview
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: a second client key of the same project, used by the server only (never NEXT_PUBLIC_, so it is not in the bundle).
# A flood of forged events through the public key then cannot starve the real errors of the server. Empty: the server uses the public key.
# Set it in Vercel for Production and Preview
SENTRY_DSN=""
# Organization auth token and the slugs of the organization and the project: they upload the source maps in the Vercel build.
# Set all three in Vercel for Production only. A build without the token uploads nothing and generates no source maps
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
