{
  "name": "devstash",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate && node scripts/copy-monaco.mjs",
    "build": "prisma generate && node scripts/copy-monaco.mjs && next build",
    "vercel-build": "tsx scripts/migrate-if-allowed.ts && npm run build",
    "start": "next start",
    "lint": "eslint",
    "lint:dup": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:seed": "prisma db seed",
    "db:seed-test": "tsx scripts/seed-test.ts",
    "db:test": "tsx scripts/test-db.ts",
    "db:delete-users": "tsx scripts/delete-users.ts",
    "db:reset-demo": "tsx --conditions=react-server scripts/reset-demo.ts",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:instant": "playwright test --config playwright.instant.config.ts",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "11.12.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.73.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "openai": "^7.57.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "pg": "8.23.1",
    "playwright": "1.65.1",
    "prettier": "3.9.10",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.1",
    "storybook": "10.6.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
